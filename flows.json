    {
        "id": "store_sensor",
        "type": "function",
        "z": "07b4b3b2ea4722d9",
        "name": "Simpan Data Sensor",
        "func": "// Simpan ke context global\nvar data = msg.payload;\ndata.received = new Date().toISOString();\n\n// Ambil batas suhu\nvar threshold = flow.get(\"temperatureThreshold\");\n\n// Periksa apakah suhu melebihi batas\nif (\n    Number.isFinite(Number(data.suhu)) &&\n    Number.isFinite(threshold) &&\n    Number(data.suhu) > threshold\n) {\n    data.alert = \"PERINGATAN: Suhu melebihi batas!\";\n    \n    node.warn(\n        \"PERINGATAN! Suhu \" + data.suhu +\n        \"°C melebihi threshold \" + threshold + \"°C\"\n    );\n}\n\nflow.set('lastSensor', data);\n\n// Simpan history (max 50 data)\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 560,
        "wires": [
            [
                "debug_sensor",
                "1d995ea4e8de8e84",
                "dbfb47483d7cc52e"
            ]
