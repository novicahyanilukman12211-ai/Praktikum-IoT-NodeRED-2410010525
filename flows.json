    {
        "id": "e37d08cb13db41f4",
        "type": "function",
        "z": "07b4b3b2ea4722d9",
        "name": "Set Temperature Threshold",
        "func": "\nconst threshold = Number(msg.payload.threshold);\n\nif (!Number.isFinite(threshold) || threshold <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Threshold harus berupa angka lebih dari 0\"\n    };\n    return msg;\n}\n\nflow.set(\"temperatureThreshold\", threshold);\n\nmsg.payload = {\n    status: \"success\",\n    message: \"Temperature threshold berhasil diatur\",\n    threshold: threshold\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
