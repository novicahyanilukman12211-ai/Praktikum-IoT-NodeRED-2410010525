        "type": "function",
        "z": "07b4b3b2ea4722d9",
        "name": "Simpan Riwayat ke SQLite",
        "func": "const data = msg.payload;\n\nmsg.topic = `\nINSERT INTO sensor_history (suhu, kelembaban, timestamp)\nVALUES ($suhu, $kelembaban, $timestamp);\n`;\n\nmsg.payload = [\n    Number(data.suhu),\n    Number(data.kelembaban),\n    data.timestamp || new Date().toISOString()\n];\n\nreturn msg;",
